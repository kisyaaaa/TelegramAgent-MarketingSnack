# Copie ce fichier en ".env" et remplis les valeurs (le fichier .env n'est jamais versionné).
# En production (GitHub Actions), ces valeurs sont stockées dans les "Secrets" du dépôt.

# Token du bot, fourni par @BotFather
TELEGRAM_BOT_TOKEN=

# Identifiant de la conversation qui reçoit la revue de presse
TELEGRAM_CHAT_ID=

# Clé API Groq : https://console.groq.com/keys
GROQ_API_KEY=
